{
  "manifest_version": 3,
  "name": "Unwall Clipboard",
  "version": "1.1.0",
  "description": "Takes the URL on your clipboard and opens it via unwall.app.",
  "permissions": ["clipboardRead", "offscreen"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open clipboard URL in Unwall"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+U",
        "mac": "Command+Shift+U"
      },
      "description": "Open clipboard URL in Unwall"
    }
  }
}
